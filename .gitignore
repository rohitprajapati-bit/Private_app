# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# --- Backend secrets (remote sharing) — never commit these ---
# Service account keys (any location)
**/service-account*.json
**/*serviceAccount*.json
backend/**/service-account.json
# Environment & local secrets
**/.env
**/.env.*
!**/.env.example
**/.dev.vars
!**/.dev.vars.example
# Admin OAuth token cache
backend/admin-cli/.token.json
# Node deps
backend/**/node_modules/
