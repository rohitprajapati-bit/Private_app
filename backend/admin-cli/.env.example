# Copy to `.env` and fill in. `.env` and the service-account key are git-ignored.

# Path to the service account JSON you downloaded from Firebase (keep it in this folder,
# named service-account.json, so it is covered by .gitignore).
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# From the service account JSON (project_id) and your Firebase project.
GCP_PROJECT_ID=your-project-id

# The dedicated Drive folder id (from the folder URL …/folders/<THIS>).
DRIVE_FOLDER_ID=your-folder-id

# Tenant tag that owns libraries/codes. Leave as "admin" unless you add a Firebase-Auth admin app.
ADMIN_OWNER_UID=admin

# Optional: your deployed Worker URL, stored in the config doc for reference.
BROKER_URL=
